{
	"version": 6,
	"configurePresets": [
		{
			"name": "release",
			"binaryDir": "${sourceDir}/build",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "release-windows",
			"inherits": "release",
			"generator": "Ninja"
		}
	],
	"buildPresets": [
		{
			"name": "release",
			"configurePreset": "release"
		},
		{
			"name": "release-windows",
			"configurePreset": "release-windows"
		}
	],
	"workflowPresets": [
		{
			"name": "release",
			"steps": [
				{
					"type": "configure",
					"name": "release"
				},
				{
					"type": "build",
					"name": "release"
				}
			]
		},
		{
			"name": "release-windows",
			"steps": [
				{
					"type": "configure",
					"name": "release-windows"
				},
				{
					"type": "build",
					"name": "release-windows"
				}
			]
		}
	]
}